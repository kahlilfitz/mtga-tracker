{
  "name": "mtga-tracker",
  "version": "1.0.4",
  "description": "A local dashboard for tracking your MTG Arena match history, rank, and inventory. No accounts, no cloud — reads directly from the game's log file on macOS.",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahlilfitz/mtga-tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kahlilfitz/mtga-tracker/issues"
  },
  "homepage": "https://github.com/kahlilfitz/mtga-tracker#readme",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/sql.js": "^1.4.11",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.kahlilfitz.mtga-tracker",
    "productName": "MTG Arena Tracker",
    "files": [
      "dist-electron/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "kahlilfitz",
      "repo": "mtga-tracker"
    }
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
